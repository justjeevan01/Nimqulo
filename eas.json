{
  "cli": {
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "android": {
        "buildType": "apk"
      },
      "extends": "base",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://br-calm-frost-a1ndi9sf-api.compute.c-1.ap-southeast-1.aws.neon.tech/"
      }
    },
    "release": {
      "distribution": "internal",
      "environment": "production",
      "android": {
        "buildType": "apk"
      },
      "extends": "base",
      "env": {
        "APP_VARIANT": "pilot",
        "EXPO_PUBLIC_API_URL": "https://br-square-feather-a14064tt-api.compute.c-1.ap-southeast-1.aws.neon.tech/"
      }
    },
    "release-check": {
      "extends": "release",
      "developmentClient": false,
      "env": {
        "RELEASE_TEST_EMULATOR": "1"
      }
    },
    "base": {}
  }
}
