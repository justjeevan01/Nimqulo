{
  "expo": {
    "name": "Nimqulo",
    "slug": "Triply-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon.png",
    "scheme": "triplyai",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/app-icon.png"
    },
    "android": {
      "package": "com.jeeva.nimqulo",
      "allowBackup": false,
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/app-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "icon": "./assets/images/app-icon.png"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/nimqulo-icon.png",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-router",
        {
          "asyncRoutes": {
            "web": false
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#020B18",
          "image": "./assets/images/nimqulo-mark.png",
          "imageWidth": 100
        }
      ],
      [
        "@clerk/expo",
        {
          "appleSignIn": false
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Nimqulo to choose your profile photo.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0873FF",
          "defaultChannel": "messages"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": false
        }
      },
      "eas": {
        "projectId": "52d5439b-cdc5-4e83-a810-cf723fe8208a"
      }
    }
  }
}
