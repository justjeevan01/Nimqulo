# Public Android API URL. google-services.json contains public Firebase app configuration.
EXPO_PUBLIC_API_URL=https://your-neon-function-invocation-url/

# Server/CLI only. Never prefix these with EXPO_PUBLIC_.
FIREBASE_PROJECT_ID=nimqulo
# Base64-encoded Firebase Admin service-account JSON; keep the key file private.
FIREBASE_ADMIN_CONFIG=
DATABASE_URL=
DATABASE_URL_UNPOOLED=
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
APP_ORIGINS=triplyai://
REALTIME_URL=
REALTIME_SERVICE_KEY=
OPERATOR_USER_IDS=
# Optional local smoke credentials from your own active Firebase app session.
BACKEND_TEST_TOKEN=
BACKEND_TEST_SESSION_NONCE=
BACKEND_TEST_USER_ID=
